---
import PageLayout from '../layouts/PageLayout.astro'
import Bio from '../components/Bio.astro'
import PostList, { type PostSummary } from '../components/PostList'
import { t, LANGS, type Alternates, type Lang } from '../i18n/ui'
import { excerpt, getListedPosts, homeUrl, postUrl } from '../lib/posts'
import { SITE } from '../site.config'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const posts: PostSummary[] = (await getListedPosts(lang)).map((post) => ({
  url: postUrl(post),
  title: post.data.title,
  category: post.data.category!,
  date: post.data.date.toISOString(),
  excerpt: excerpt(post.body, 200),
}))
const categories = [...new Set(posts.map((post) => post.category))]
const alternates: Alternates = Object.fromEntries(LANGS.map((code) => [code, homeUrl(code)]))
---

<PageLayout lang={lang} title={t(lang, 'homeTitle')} keywords={SITE.keywords} alternates={alternates}>
  <Bio lang={lang} />
  <PostList client:load posts={posts} categories={categories} countOfInitialPost={SITE.countOfInitialPost} />
</PageLayout>
