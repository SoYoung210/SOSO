---
import { SITE } from '../site.config'

interface Props {
  /** Language-independent post path, e.g. `react/scoped-context`. */
  slug: string
}

// Both language versions share one issue. Its title is the Gatsby-era pathname without the leading
// slash (percent-encoded, e.g. `react/scoped-context/`), which is what `issue-term="pathname"` created.
const issueTerm = `${encodeURI(Astro.props.slug)}/`
---

<div class="utterances-root" data-repo={SITE.utterancesRepo} data-issue-term={issueTerm}></div>

<script>
  const root = document.querySelector<HTMLElement>('.utterances-root')
  const themeFor = (dark: boolean) => (dark ? 'github-dark' : 'github-light')

  if (root) {
    const script = document.createElement('script')
    Object.entries({
      src: 'https://utteranc.es/client.js',
      repo: root.dataset.repo!,
      branch: 'main',
      'issue-term': root.dataset.issueTerm!,
      theme: themeFor(document.body.classList.contains('dark')),
      crossorigin: 'anonymous',
    }).forEach(([key, value]) => script.setAttribute(key, value))
    script.async = true
    root.appendChild(script)

    document.addEventListener('themechange', (event) => {
      const { dark } = (event as CustomEvent<{ dark: boolean }>).detail
      root
        .querySelector<HTMLIFrameElement>('iframe.utterances-frame')
        ?.contentWindow?.postMessage({ type: 'set-theme', theme: themeFor(dark) }, 'https://utteranc.es')
    })
  }
</script>
