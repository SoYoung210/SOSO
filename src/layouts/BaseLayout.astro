---
import '@fontsource/noto-sans-kr/300.css'
import '@fontsource/noto-sans-kr/400.css'
import '@fontsource/noto-sans-kr/500.css'
import '@fontsource/noto-sans-kr/700.css'
import '@fontsource/catamaran/700.css'
import '@fontsource/catamaran/800.css'
import '@fontsource/catamaran/900.css'
import '../styles/base.css'
import '../styles/theme.css'

import BaseHead from '../components/BaseHead.astro'
import Integrations from '../components/Integrations.astro'
import { THEME_KEY } from '../lib/theme'
import { LANG_META } from '../i18n/ui'

type Props = import('astro/types').ComponentProps<typeof BaseHead>
---

<!doctype html>
<html lang={LANG_META[Astro.props.lang].htmlLang}>
  <head>
    <BaseHead {...Astro.props} />
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
    <Integrations />
  </head>
  <body>
    <script is:inline define:vars={{ themeKey: THEME_KEY }}>
      // Set the theme before first paint so there is no flash.
      let dark
      try {
        dark = JSON.parse(localStorage.getItem(themeKey))
      } catch {}
      if (typeof dark !== 'boolean') dark = matchMedia('(prefers-color-scheme: dark)').matches
      document.body.classList.add(dark ? 'dark' : 'light')
    </script>
    <slot />
  </body>
</html>
